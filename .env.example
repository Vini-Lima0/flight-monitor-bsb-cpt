# Copie este arquivo para ".env" para rodar localmente (o .env nunca é commitado).
# Em produção (GitHub Actions), os mesmos nomes viram GitHub Secrets — ver README.

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- E-mail (SMTP) ---
# Padrão: Gmail com "senha de app" (ver passo a passo no README)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=465
EMAIL_SENDER=seu-email@gmail.com
EMAIL_APP_PASSWORD=
